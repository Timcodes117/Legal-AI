# Used by FastAPI. On deploy, set these on the backend host instead of committing a file.
INTRON_API_KEY=paste_your_key_here
SAHARA_STT_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_TTS_URL=https://infer.voice.intron.io/tts/v1/generate

# Comma-separated frontend origins. Production always also allows the Vercel UI.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://legal-ai-web-five.vercel.app

# Local ASR benchmark only (scripts/benchmark_asr.py). Not used by the live API.
GEMINI_API_KEY=paste_your_gemini_key_here
GEMINI_STT_MODEL=gemini-3.6-flash
WHISPER_MODEL=tiny
HF_TOKEN=paste_your_hf_token_here
